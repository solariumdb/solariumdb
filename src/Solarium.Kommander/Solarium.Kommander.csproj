<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SolariumDb.Kommander</PackageId>
    <Description>A Kommander write-ahead log (IWAL) on Solarium, an embedded key-value store for .NET with RocksDB's API.</Description>
    <PackageTags>raft;kommander;wal;solarium;key-value</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kommander" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solarium\Solarium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Solarium.Kommander.Tests" />
    <InternalsVisibleTo Include="Solarium.Kommander.Benchmarks" />
  </ItemGroup>

</Project>
